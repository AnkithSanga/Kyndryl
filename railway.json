{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn --bind 0.0.0.0:$PORT --workers 4 --timeout 120 app:app",
    "restartPolicyCondition": "on-failure",
    "restartPolicyMaxRetries": 5
  }
}
